function Home(){const[q,setQ]=useState('');const popular=tools.filter(t=>t.featured||t.trending).slice(0,8);const cats=categories;const results=q?tools.filter(t=>(t.name+' '+t.description+' '+t.keywords.join(' ')).toLowerCase().includes(q.toLowerCase())).slice(0,5):[];return <><main><section className="hero"><div className="container heroGrid"><div><span className="eyebrow">⚡ 100+ practical utilities</span><h1>Everyday tools.<br/><span style={{color:'var(--primary)'}}>One simple place.</span></h1><p className="lead">Fast, simple and useful tools for everyday life, study, work and creativity.</p><div className="actions"><Link className="btn primary" to="/tools">Explore Tools <ArrowRight size={16}/></Link><Link className="btn" to="/tools?sort=popular">Popular Tools</Link></div><div className="searchbox"><Search size={20}/><input aria-label="Search tools" value={q} onChange={e=>setQ(e.target.value)} placeholder="Try EMI Calculator, QR Generator, Image Compressor…"/>{q&&<button className="btn" onClick={()=>setQ('')}>Clear</button>}</div>{results.length>0&&<div className="card" style={{marginTop:8,position:'relative',zIndex:2}}>{results.map(t=><Link key={t.id} to={'/tools/'+t.slug} style={{display:'block',padding:'10px 0',borderBottom:'1px solid var(--border)'}}>{t.icon} {t.name}<span className="muted"> — {t.category}</span></Link>)}</div>}</div><div className="card" style={{minHeight:310,display:'grid',placeItems:'center',background:'linear-gradient(135deg,#0b1220,#1b2f72)'}}><div style={{textAlign:'center',color:'white'}}><div style={{fontSize:76}}>🧰</div><h2 style={{margin:'8px 0'}}>Your everyday toolkit</h2><p style={{color:'#b8c2d2'}}>Calculators · files · images · text · developer utilities</p></div></div></div></section><section className="section"><div className="container"><div className="sectionhead"><div><span className="muted">Start here</span><h2>Popular tools</h2></div><Link to="/tools">View all →</Link></div><ToolGrid items={popular}/></div></section><section className="section"><div className="container"><div className="sectionhead"><div><span className="muted">Browse</span><h2>Categories</h2></div></div><div className="grid categorygrid">{cats.map(([id,name,desc])=><Link className="card catcard" to={'/categories/'+id} key={id}><div className="toolicon">{tools.find(t=>t.category===id)?.icon}</div><h3>{name}</h3><p className="muted">{desc}</p></Link>)}</div></div></section><section className="section"><div className="container"><div className="card" style={{background:'linear-gradient(135deg,#eaf0ff,#e8fffb)'}}><h2>Why TOOLORA?</h2><p className="lead">Useful by default, privacy-conscious, and designed to work quickly on phones and desktops. Browser-first processing keeps supported files on your device.</p></div></div></section><section className="section"><div className="container"><div className="sectionhead"><div><span className="muted">Learn</span><h2>Featured guides</h2></div><Link to="/guides">All guides →</Link></div><div className="grid">{['How to calculate EMI','How to calculate percentage','How to calculate CGPA','How to compress images'].map((x,i)=><Link className="card" key={x} to={'/guides/'+['emi','percentage','cgpa','compress-images'][i]}><span className="tag">Guide</span><h3>{x}</h3><p className="muted">A practical, human-first explanation with examples and common mistakes.</p></Link>)}</div></div></section></main></>}
function ToolPage(){const{slug}=useParams();const tool=tools.find(t=>t.slug===slug);const[toast,setToast]=useState('');const[history,setHistory]=useState<string[]>(JSON.parse(localStorage.getItem('toolora-history')||'[]'));useEffect(()=>{if(tool){const h=[tool.id,...history.filter(x=>x!==tool.id)].slice(0,10);setHistory(h);localStorage.setItem('toolora-history',JSON.stringify(h))}},[tool?.id]);if(!tool)return <NotFound/>;const copy=async(v:string)=>{await navigator.clipboard?.writeText(v);setToast('Copied successfully');setTimeout(()=>setToast(''),1800)};return <div className="page"><div className="container"><div className="toolwrap"><div><div className="toolpanel"><div className="toolicon">{tool.icon}</div><h1 style={{fontSize:'clamp(34px,5vw,54px)',margin:'10px 0'}}>{tool.name}</h1><p className="lead">{tool.description}</p><ToolEngine tool={tool} onCopy={copy}/></div><section className="section" style={{paddingTop:32}}><h2>How does this tool work?</h2><p className="muted">TOOLORA processes supported calculations and browser operations locally whenever practical. Check each result, especially when using financial estimates.</p><h2>Example</h2><p className="muted">Enter your information, review the result, then copy or share it. Related tools can help you explore the result from another angle.</p><h2>Frequently Asked Questions</h2><div className="card"><b>Does TOOLORA upload my files?</b><p className="muted">Supported image, text, ZIP and calculator workflows in this build run in your browser. If a future feature requires a server, the UI will identify that requirement.</p></div></section></div><aside><div className="card"><b>Related tools</b>{tools.filter(t=>t.category===tool.category&&t.id!==tool.id).slice(0,6).map(t=><p key={t.id}><Link to={'/tools/'+t.slug}>{t.icon} {t.name}</Link></p>)}</div><div className="card" style={{marginTop:16}}><b>AdSlot</b><p className="muted">Reserved for legitimate AdSense inventory. No ad is loaded until configured.</p></div></asid