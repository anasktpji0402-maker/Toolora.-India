function ToolEngine({tool,onCopy}:{tool:Tool;onCopy:(x:string)=>void}){const[type]=[tool.type];const[out,setOut]=useState('');const[a,setA]=useState('');const[b,setB]=useState('');const[c,setC]=useState('');const[files,setFiles]=useState<File[]>([]);const[text,setText]=useState('');const[quality,setQuality]=useState('0.8');const run=()=>{let r='';const n=Number(a),m=Number(b),k=Number(c);try{switch(type){case'calculator':{if(tool.id==='percentage-calculator')r=`${(n*m/100).toFixed(2)}`;else if(tool.id==='discount-calculator')r=`Final price: ${(n-(n*m/100)).toFixed(2)} (saved ${(n*m/100).toFixed(2)})`;else if(tool.id==='gst-calculator')r=`GST: ${(n*m/100).toFixed(2)} · Total: ${(n+n*m/100).toFixed(2)}`;else if(tool.id==='emi-calculator'||tool.id==='loan-calculator'){const monthly=m/1200,months=k*12;const emi=monthly? n*monthly*Math.pow(1+monthly,months)/(Math.pow(1+monthly,months)-1):n/months;r=`Monthly payment: ${emi.toFixed(2)} · Total interest: ${(emi*months-n).toFixed(2)}`}else if(tool.id==='simple-interest-calculator')r=`Interest: ${(n*m*k/100).toFixed(2)} · Total: ${(n+n*m*k/100).toFixed(2)}`;else if(tool.id==='compound-interest-calculator')r=`Future value: ${(n*Math.pow(1+m/100,k)).toFixed(2)}`;else if(tool.id==='tip-calculator')r=`Tip: ${(n*m/100).toFixed(2)} · Total: ${(n+n*m/100).toFixed(2)}`;else if(tool.id==='fuel-cost-calculator')r=`Estimated fuel cost: ${(n/m*k).toFixed(2)}`;else if(tool.id==='profit-margin-calculator')r=`Margin: ${(((n-m)/n)*100).toFixed(2)}%`;else if(tool.id==='break-even-calculator')r=`Break-even units: ${(n/(m-k)).toFixed(2)}`;else if(tool.id==='average-calculator'){const vals=a.split(',').map(Number).filter(Number.isFinite);r=`Average: ${(vals.reduce((x,y)=>x+y,0)/vals.length).toFixed(2)}`}else if(tool.id==='ratio-calculator'){const g=(x:number,y:number):number=>y?g(y,x%y):Math.abs(x);const d=g(n,m);r=`Simplified ratio: ${n/d}:${m/d}`}else if(tool.id==='fraction-calculator'){const[x,y]=a.split('/').map(Number),[z,w]=b.split('/').map(Number);r=`Result: ${((x*w+z*y)/(y*w)).toString()}`}else r=`Result: ${(n||0)+(m||0)}`;break}case'text':{if(tool.id==='word-counter'||tool.id==='character-counter'||tool.id==='sentence-counter'||tool.id==='line-counter'||tool.id==='reading-time-calculator'){const words=text.trim()?text.trim().split(/\s+/).length:0;const chars=text.length;const sentences=text.split(/[.!?]+/).filter(x=>x.trim()).length;const lines=text?text.split(/\n/).length:0;r=tool.id==='word-counter'?`Words: ${words} · Characters: ${chars} · Sentences: ${sentences}`:tool.id==='character-counter'?`Characters: ${chars}`:tool.id==='sentence-counter'?`Sentences: ${sentences}`:tool.id==='line-counter'?`Lines: ${lines}`:`Estimated reading time: ${Math.max(1,Math.ceil(words/200))} min`}else if(tool.id==='case-converter')r=text.toUpperCase();else if(tool.id==='slug-generator')r=text.toLowerCase().trim().replace(/[^\w\s-]/g,'').replace(/\s+/g,'-');else if(tool.id==='remove-duplicate-lines')r=[...new Set(text.split('\n'))].join('\n');else if(tool.id==='text-sorter')r=text.split('\n').sort((x,y)=>x.localeCompare(y)).join('\n');else if(tool.id==='find-replace')r=text.split(a).join(b);else r=text.trim().replace(/\s+/g,' ');break}case'json':{const j=JSON.parse(text);r=tool.id==='json-validator'?'Valid JSON':JSON.stringify(j,null,2);break}case'base64':r=tool.id==='base64-encoder'?btoa(unescape(encodeURIComponent(text))):decodeURIComponent(escape(atob(text)));break;case'url':r=tool.id==='url-encoder'?encodeURIComponent(text):decodeURIComponent(text);break;case'html':r=tool.id==='html-encoder'?text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'):formatCode(text);break;case'code':r=tool.id.includes('css')?formatCode(text):formatCode(text);break;case'timestamp':r=tool.id==='timestamp-converter'?new Date(Number(a)*1000).toISOString():`${Math.floor(Date.now()/1000)}`;break;case'color':{const h=text.replace('#','');const x=parseInt(h.length===3?h.split('').map(s=>s+s).join(''):h,16);r=`RGB(${x>>16&255}, ${x>>8&255}, ${x&255})`;break}case'uuid':r=crypto.randomUUID();break;case'regex':{const re=new RegExp(a,b||'g');r=re.test(text)?'Match found':'No match';break}case'jwt':{const p=text.split('.')[1];r=JSON.stringify(JSON.parse(atob(p.replace(/-/g,'+').replace(/_/g,'/'))),null,2);break}default:r='';}setOut(r)}catch(e){setOut('Please check the input and try again.')} };
if(['ai'].includes(type))return <AIBox/>;if(['image','imageconvert','imagepdf','imageinfo','pdf','pdfimage','zip','qr'].includes(type))return <FileTool tool={tool} onCopy={onCopy}/>;if(type==='scientific')return <Scientific/>;if(type==='timer'||type==='countdown'||type==='planner')return <TimerTool tool={tool}/>;return <div><h2 style={{marginTop:28}}>Tool workspace</h2>{type==='calculator'?<><Field label="Value / principal" type="number" value={a} onChange={e=>setA(e.target.value)} placeholder="10000"/><Field label="Rate / second value" type="number" value={b} onChange={e=>setB(e.target.value)} placeholder="8.5"/><Field label="Years / third value" type="number" value={c} onChange={e=>setC(e.target.value)} placeholder="5"/></>:type==='text'||type==='json'||type==='base64'||type==='url'||type==='html'||type==='code'||type==='regex'||type==='jwt'||type==='color'?<><label className="field"><span>Input</span><textarea className="textarea" value={text} onChange={e=>setText(e.target.value)} placeholder="Type or paste here…"/></label>{['find-replace','regex'].includes(tool.id)&&<Field label={tool.id==='regex'?'Pattern':'Find'} value={a} onChange={e=>setA(e.target.value)}/>} {tool.id==='find-replace'&&<Field label="Replace with" value={b} onChange={e=>setB(e.target.value)}/>}</>:<></>}<div className="actions"><button className="btn primary" onClick={run}>Run tool</button>{out&&<button className="btn" onClick={()=>onCopy(out)}><Copy size={16}/> Copy</button>}</div>{out&&<div className="result" style={{whiteSpace:'pre-wrap'}}>{out}</div>}{['finance'].includes(tool.category)&&<div className="notice">Educational estimate only. Results depend on the assumptions and inputs you provide and are not financial advice.</div>}</div>}
function formatCode(x:string){return x.replace(/>\s*</g,'>\n<').replace(/[ \t]+/g,' ').trim()}
