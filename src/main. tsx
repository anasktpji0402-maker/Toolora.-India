function CategoryPage(){const{id}=useParams();const cat=categories.find(c=>c[0]===id);const list=tools.filter(t=>t.category===id);if(!cat)return <NotFound/>;return <div className="page"><div className="container"><h1>{cat[1]}</h1><p className="lead">{cat[2]}</p><ToolGrid items={list}/></div></div>}
function Guides(){return <div className="page"><div className="container"><h1>Guides</h1><p className="lead">Practical explanations for everyday calculations and digital tasks.</p><div className="grid">{['emi','percentage','cgpa','attendance','compress-images','jpg-png','qr','compound-interest','discount','split-expenses'].map((id)=><Link className="card" to={'/guides/'+id} key={id}><span className="tag">Guide</span><h3>{id.replaceAll('-',' ').replace(/\b\w/g,x=>x.toUpperCase())}</h3><p className="muted">Step-by-step guidance, formulas, examples and common mistakes.</p></Link>)}</div></div></div>}
function Guide(){const{id}=useParams();return <div className="page"><div className="container" style={{maxWidth:820}}><span className="tag">Guide</span><h1>{(id||'guide').replaceAll('-',' ').replace(/\b\w/g,x=>x.toUpperCase())}</h1><p className="lead">A practical TOOLORA guide designed for humans first.</p><h2>What it means</h2><p className="muted">Start with the inputs you know, keep units consistent, and review the assumptions behind the result. TOOLORA tools are designed to make the arithmetic transparent rather than hide it.</p><h2>How to use the tool</h2><ol className="muted"><li>Open the matching tool.</li><li>Enter your values carefully.</li><li>Review the result and assumptions.</li><li>Copy or share only after checking the inputs.</li></ol><h2>Common mistakes</h2><p className="muted">Mixing units, entering percentages as whole numbers when a decimal is expected, and treating estimates as guarantees are common sources of error.</p></div></div>}
function InfoPage({title,children}:{title:string;children:React.ReactNode}){return <div className="page"><div className="container" style={{maxWidth:850}}><h1>{title}</h1>{children}</div></div>}
function Contact(){const[s,setS]=useState('');return <InfoPage title="Contact"><p className="lead">Tell us what you need help with.</p><div className="toolpanel"><Field label="Name" placeholder="Your name"/><Field label="Email" type="email" placeholder="you@example.com"/><Field label="Subject" placeholder="How can we help?"/><label className="field"><span>Message</span><textarea className="textarea" placeholder="Your message"/></label><button className="btn primary" onClick={()=>setS('Contact delivery is not configured yet. Add CONTACT_API_URL and a real backend to enable sending.')}>Send message</button>{s&&<div className="notice" style={{marginTop:14}}>{s}</div>}</div></InfoPage>}
function NotFound(){return <InfoPage title="Oops! This tool went missing."><p className="lead">The page you requested does not exist.</p><div className="actions"><Link className="btn primary" to="/">Back Home</Link><Link className="btn" to="/tools">Explore Tools</Link></div></InfoPage>}
function App(){const loc=useLocation();useEffect(()=>{const t=loc.pathname.startsWith('/tools/')?`TOOLORA Tool — ${loc.pathname.split('/').pop()?.replaceAll('-',' ')}`:loc.pathname==='/'?'TOOLORA — Everyday tools. One simple place.':`TOOLORA — ${loc.pathname.slice(1).replaceAll('-',' ')}`;document.title=t.replace(/\b\w/g,x=>x.toUpperCase());const d=document.querySelector('meta[name=description]');if(d)d.setAttribute('content','TOOLORA — fast, simple and useful everyday digital tools.');let c=document.querySelector('link[rel=canonical]') as HTMLLinkElement|null;if(!c){c=document.createElement('link');c.rel='canonical';document.head.appendChild(c)}c.href=(import.meta.env.VITE_SITE_URL||location.origin)+loc.pathname},[loc.pathname]);return <><Splash/><Nav/><Routes/><Footer/></>}
function Routes(){const loc=useLocation();if(loc.pathname==='/')return <Home/>;if(loc.pathname==='/tools')return <ToolsPage/>;if(loc.pathname.startsWith('/tools/'))return <ToolPage/>;if(loc.pathname==='/categories')return <CategoriesPage/>;if(loc.pathname.startsWith('/categories/'))return <CategoryPage/>;if(loc.pathname==='/guides')return <Guides/>;if(loc.pathname.startsWith('/guides/'))return <Guide/>;if(loc.pathname==='/about')return <InfoPage title="About TOOLORA"><p className="lead">TOOLORA is an all-in-one everyday digital tools platform for normal users, students, youth, creators, freelancers, professionals and developers.</p><h2>Mission</h2><p className="muted">To make useful digital tools simple and accessible for everyone.</p></InfoPage>;if(loc.pathname==='/contact')return <Contact/>;if(loc.pathname==='/privacy')return <InfoPage title="Privacy Policy"><p className="muted">This editable starter policy explains the product intent but is not legal advice. TOOLORA should update this page for its actual analytics, advertising, hosting, retention and regional obligations before launch.</p><h2>Local processing</h2><p className="muted">Supported browser tools process data locally. Features that require a server must disclose that before sending data.</p></InfoPage>;if(loc.pathname==='/terms')return <InfoPage title="Terms & Conditions"><p className="muted">TOOLORA provides tools for convenience. Users are responsible for checking outputs and using the service lawfully. This placeholder must be reviewed for the operator's jurisdiction.</p></InfoPage>;if(loc.pathname==='/disclaimer')return <InfoPage title="Disclaimer"><p className="muted">Financial and educational calculations are estimates based on user inputs and assumptions, not professional advice or guarantees.</p></InfoPage>;if(loc.pathname==='/cookies')return <InfoPage title="Cookie Information"><p className="muted">Cookie and consent behavior should be configured according to the services enabled and the visitor's jurisdiction. Analytics and advertising are optional in this build.</p></InfoPage>;return <NotFound/>}
createRoot(document.getElementById('root')!).render(<BrowserRouter><App/></BrowserRouter>);
