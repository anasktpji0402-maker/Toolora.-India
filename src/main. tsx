function TimerTool({tool}:{tool:Tool}){const[sec,setSec]=useState(tool.type==='countdown'?3600:1500);const[running,setRunning]=useState(false);useEffect(()=>{if(!running)return;const id=setInterval(()=>setSec(s=>{if(s<=1){setRunning(false);return 0}return s-1}),1000);return()=>clearInterval(id)},[running]);return <div style={{marginTop:28,textAlign:'center'}}><div className="result" style={{fontSize:56}}>{Math.floor(sec/60).toString().padStart(2,'0')}:{(sec%60).toString().padStart(2,'0')}</div><div className="actions" style={{justifyContent:'center'}}><button className="btn primary" onClick={()=>setRunning(!running)}>{running?'Pause':'Start'}</button><button className="btn" onClick={()=>setSec(tool.type==='countdown'?3600:1500)}><RefreshCcw size={16}/> Reset</button></div></div>}
